{
  "version": 4,
  "terraform_version": "1.0.0",
  "serial": 1,
  "lineage": "some-lineage",
  "outputs": {},
  "resources": [
    {
      "module": "module.data_lake",
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "raw_data",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "bucket": "my-raw-data-bucket",
            "id": "my-raw-data-bucket"
          },
          "dependencies": []
        }
      ]
    },
    {
      "module": "module.data_lake",
      "mode": "managed",
      "type": "aws_glue_catalog_table",
      "name": "iceberg_table",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "my_iceberg_table",
            "database_name": "default"
          },
          "dependencies": [
            "module.data_lake.aws_s3_bucket.raw_data"
          ]
        }
      ]
    },
    {
      "module": "module.processing",
      "mode": "managed",
      "type": "aws_lambda_function",
      "name": "ingestion_lambda",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "function_name": "ingestion_lambda"
          },
          "dependencies": [
            "module.data_lake.aws_s3_bucket.raw_data"
          ]
        }
      ]
    },
    {
      "module": "module.processing",
      "mode": "managed",
      "type": "databricks_cluster",
      "name": "analytics_cluster",
      "provider": "provider[\"registry.terraform.io/hashicorp/databricks\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "cluster_name": "analytics_cluster"
          },
          "dependencies": [
            "module.data_lake.aws_glue_catalog_table.iceberg_table"
          ]
        }
      ]
    },
    {
      "module": "module.orchestration",
      "mode": "managed",
      "type": "aws_sfn_state_machine",
      "name": "etl_pipeline",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "etl_pipeline"
          },
          "dependencies": [
            "module.processing.aws_lambda_function.ingestion_lambda",
            "module.processing.databricks_cluster.analytics_cluster"
          ]
        }
      ]
    }
  ]
}
